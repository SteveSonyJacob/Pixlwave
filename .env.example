# Runtime. Copy to .env.local and replace every change-me value.
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://change-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=change-me

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=change-me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOG_LEVEL=info

# Auth delivery selected for P01: verified email/password plus recovery and Google OAuth.
AUTH_EMAIL_METHOD=password
AUTH_SMTP_PROVIDER=change-me
AUTH_SMS_PROVIDER=deferred
AUTH_OAUTH_PROVIDERS=google
AUTH_SESSION_IDLE_MINUTES=60
AUTH_ADMIN_MFA_REQUIRED=true

# India-region deployment declarations. Runtime validation rejects other main-data regions.
APP_COMPUTE_REGION=ap-south-1
DATABASE_REGION=ap-south-1
OBJECT_STORAGE_REGION=ap-south-1
BACKUP_REGION=ap-south-1
LOG_REGION=ap-south-1

# Provider adapter selection. Keys remain in provider secret stores / deployment secrets.
MAPS_PRIMARY_PROVIDER=mappls
MAPS_FALLBACK_PROVIDER=google
MAPPLS_SEARCH_URL=https://atlas.mappls.com/api/places/search/json
MAPPLS_ACCESS_TOKEN=change-me
GOOGLE_GEOCODING_API_KEY=change-me
OBJECT_STORAGE_PROVIDER=supabase
MEDIA_PRIVATE_BUCKET=pixlwave-private-media
PAYMENT_PROVIDER=razorpay

# Test-only. Never enable in staging or production.
DATABASE_ALLOW_TEST_AUTH_STUBS=false
