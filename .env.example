APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://user:password@host:5432/postgres
LOG_LEVEL=info
AUTH_EMAIL_METHOD=password
AUTH_SMTP_PROVIDER=configure-provider
AUTH_SMS_PROVIDER=configure-provider
AUTH_OAUTH_PROVIDERS=google
AUTH_SESSION_IDLE_MINUTES=60
AUTH_ADMIN_MFA_REQUIRED=true
APP_COMPUTE_REGION=ap-south-1
DATABASE_REGION=ap-south-1
OBJECT_STORAGE_REGION=ap-south-1
BACKUP_REGION=ap-south-1
LOG_REGION=ap-south-1
MAPS_PRIMARY_PROVIDER=openstreetmap
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional identification contact sent to a compatible Nominatim service.
# MAPS_CONTACT_EMAIL=maps@example.com
OBJECT_STORAGE_PROVIDER=supabase
MEDIA_PRIVATE_BUCKET=pixlwave-private-media
# The durable worker uses a persisted weekly schedule for expired support attachments.
APP_EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM=Pixlwave <notifications@example.com>
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret
PAYMENT_PROVIDER=razorpay
# Test-only. Keep false outside an isolated database whose name contains "test".
P04_FIXTURE_FUNDING_ENABLED=false
DATABASE_ALLOW_TEST_AUTH_STUBS=false
