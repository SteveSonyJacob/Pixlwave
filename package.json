{
  "name": "pixlwave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docs": "node scripts/verify-docs.mjs",
    "test:watch": "vitest",
    "worker": "tsx src/worker/index.ts",
    "worker:once": "tsx src/worker/index.ts --once",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:test": "tsx scripts/test-migrations.ts",
    "seed:auth": "tsx scripts/seed-auth.ts",
    "admin:access": "tsx scripts/admin-access.ts",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run test:docs && npm run build && npm run check:client-secrets"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "6.0.2",
    "vitest": "5.0.1"
  }
}
